// Deploy: firebase deploy --only firestore
// - get: lettura singolo documento (join con codice, partita nota per id).
// - list: solo query che restituiscono partite di cui sei owner (nessuna enumerazione delle lobby altrui).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /joinCodes/{code} {
      // Nessuna query sulla collezione: solo getDoc con id = codice a 6 caratteri.
      allow list: if false;
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['gameId'])
        && request.resource.data.gameId is string
        && exists(/databases/$(database)/documents/games/$(request.resource.data.gameId))
        && get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.owner == request.auth.uid
        && get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.joinCode == code;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.gameId is string
        && exists(/databases/$(database)/documents/games/$(resource.data.gameId))
        && get(/databases/$(database)/documents/games/$(resource.data.gameId)).data.owner == request.auth.uid;
    }

    match /games/{gameId} {
      allow create: if request.auth != null;

      // Lettura singola: owner, partecipante, oppure partita multi ancora aperta (serve join / rientro con link).
      allow get: if request.auth != null && (
        resource.data.owner == request.auth.uid
        || request.auth.uid in resource.data.get('participants', {})
        || (
          resource.data.get('voteMode', 'single') == 'multi'
          && resource.data.get('status', 'setup') in ['lobby', 'vote']
        )
      );

      // Solo elenco delle proprie partite (es. home / eliminazione account).
      allow list: if request.auth != null
        && resource.data.owner == request.auth.uid;

      allow update: if request.auth != null
        && (resource.data.owner == request.auth.uid
            || request.auth.uid in resource.data.get('participants', {})
            || request.auth.uid in request.resource.data.get('participants', {}));

      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
