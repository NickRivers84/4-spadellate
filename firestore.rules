// Deploy con: firebase deploy --only firestore (dalla root del progetto, con Firebase CLI inizializzato)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{gameId} {
      // Lettura: solo utenti autenticati (serve per join con codice e per giocare)
      allow read: if request.auth != null;
      // Creazione: solo utenti autenticati (creano partita)
      allow create: if request.auth != null;
      // Aggiornamento: owner della partita, partecipanti già in partita, o chi si sta aggiungendo (join)
      allow update: if request.auth != null
        && (resource.data.owner == request.auth.uid
            || request.auth.uid in resource.data.participants
            || request.auth.uid in request.resource.data.participants);
      // Eliminazione: solo owner della partita
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
